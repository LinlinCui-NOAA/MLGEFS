#!/bin/bash

#PBS -o mlgfs_tracker.out
#PBS -e mlgfs_tracker.err
#PBS -N mlgfs_tracker
#PBS -A GFS-DEV
#PBS -q dev
#PBS -l place=vscatter,select=1:ncpus=1:mpiprocs=1:mem=10G
#PBS -l place=excl
#PBS -l walltime=00:30:00

#%include <head.h> 
#%include <envir-p2.h>

export clustername=wcoss2
export PACKAGEROOT=/lfs/h2/emc/nems/noscrub/linlin.cui/git/LinlinCui-NOAA/TC_tracker
module use $PACKAGEROOT/modulefiles
module load $clustername.lua
module list

set -x
export envir=dev

export DATAROOT=/lfs/h2/emc/ptmp/$USER
export COMROOT=$DATAROOT/com/mlgfs
export KEEPDATA=NO

# experiment configurations:
#export PDY=$1
#export cyc=$2
#export pert=$3
export job=aigfs_track_$cyc
#member: EAGLE_SOLO:"", EAGLE_ENSEMBLE:c00, p01, ... , p30, weight: 0, 1, 2, ..., 30
# EAGLE SOLO:
#export pert=""
#export modelversion=""
# EAGLE ensemble
#modelname has to be 4 letters, EAGLE_SOLO:MGFS/MGFT, EAGLE_ENSEMBLE:MC00, MP01, ..., MP30
if [ "$pert" = "" ]; then
   export COMINgfs=$DATAROOT/mlgfs.$PDY
   export ensmemble=""
   export fileprefix=mlgfs
   if [ "$modelversion" = "" ]; then
       export modelname="MGFS"
   elif [ "$modelversion" = "_test" ]; then
       export modelname="MGFT"
   fi
else
   export COMINgfs=$DATAROOT/mlgefs.$PDY
   pertmember=`echo $pert | cut -c2-3`
   weight=$(expr $pertmember + 0)
   export ensmember=""
   export fileprefix=ml$pert
   export modelname="M"$(echo "$pert" | tr '[:lower:]' '[:upper:]')
fi
#model history files
export COMINsyn=/lfs/h1/ops/prod/com/gfs/v16.3/syndat

# CALL executable job script here
$PACKAGEROOT/jobs/JAIGFS_CYCLONE_TRACK

if [ $? -ne 0 ]; then
  echo "tracker run FAILED"
  exit
else
  echo "tracker run FINISHED"
fi

